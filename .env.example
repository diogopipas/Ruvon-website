# Server-side only. Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Explicit local-only persistence. Vercel always requires Supabase.
JOLA_LOCAL_DEMO=true
# Publish a real privacy contact before collecting public leads.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional test isolation; normally leave unset.
# JOLA_DATA_DIR=.data
