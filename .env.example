# Server-side only. Never commit credentials or prefix a secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Explicit local-only persistence. Vercel always requires Supabase.
RUVON_LOCAL_DEMO=true
# Real operator identity and an inbox you control; required before public traffic.
RUVON_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# Proposed policy: review/delete prelaunch contacts within 12 months of signup.
RUVON_RETENTION_MONTHS=12
# Optional test isolation; normally leave unset.
# RUVON_DATA_DIR=.data

# RUVON_* takes precedence; legacy JOLA_* names remain supported.
# Legacy Single Sale routes stay sandbox-only. Commerce has separate launch gates.
RUVON_PAYMENTS_MODE=disabled
EASYPAY_ACCOUNT_ID=
EASYPAY_API_KEY=
# Configure these same BasicAuth credentials for the Easypay generic webhook.
EASYPAY_WEBHOOK_USERNAME=
EASYPAY_WEBHOOK_PASSWORD=
# Mandatory separate Supabase project. No fallback to the validation database.
RUVON_SANDBOX_SUPABASE_URL=
RUVON_SANDBOX_SUPABASE_SERVICE_ROLE_KEY=

# Commerce exposure is off by default. Disabling it must not stop recovery/jobs.
RUVON_LIVE_CHECKOUT_ENABLED=false
RUVON_DELIVERY_MODE=disabled
# Enable only after 006–011 + the durable worker exist in the same environment.
RUVON_COMMERCE_WEBHOOK_INBOX_ENABLED=false
RUVON_SANDBOX_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Explicit Ruvon beneficiary account; never inferred from API authentication.
EASYPAY_MARKETPLACE_ACCOUNT_ID=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
UBER_WEBHOOK_SIGNING_KEY=
# Generate independent random values of at least 32 characters.
RUVON_WORKER_SECRET=
RUVON_RATE_LIMIT_SECRET=
RUVON_OPERATOR_EMAIL=
RUVON_OPERATOR_MOBILE=
CHECKLY_HEARTBEAT_URL=
# Sender integrations still require provisioning and implementation; see status doc.
RESEND_API_KEY=
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
